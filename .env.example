# Copy this file to .env and fill in your values.
# Solvix loads .env automatically on every run.

# ── Required for both Bob Shell CLI and Bob IDE ───────────────────────────────
export GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# ── Required for Bob Shell CLI only (not needed for Bob IDE) ──────────────────
# Get your key from: https://bob.ibm.com/admin/apikeys
export BOB_API_KEY=your_bob_api_key_here
